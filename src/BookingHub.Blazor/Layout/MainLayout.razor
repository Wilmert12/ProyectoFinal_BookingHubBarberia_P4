@inherits LayoutComponentBase
@implements IDisposable
@inject SesionUsuario Sesion
@inject NavigationManager Navegacion

<header class="marca-encabezado d-flex flex-column flex-md-row justify-content-between align-items-center gap-2 px-4 py-3">
    <a class="d-flex align-items-center gap-2 text-decoration-none" href="">
        <img src="logo.svg" alt="" width="32" height="32" />
        <span class="marca-nombre">CerquilloApp</span>
    </a>
    <nav class="marca-menu nav d-flex flex-wrap justify-content-center gap-1">
        @if (Sesion.EsBarbero)
        {
            <NavLink class="nav-link" href="mi-agenda">Mi agenda</NavLink>
            <NavLink class="nav-link" href="catalogo">Catálogo</NavLink>
            <button type="button" class="nav-link btn btn-link" @onclick="Salir">Salir</button>
        }
        else
        {
            <NavLink class="nav-link" href="catalogo">Catálogo</NavLink>
            <NavLink class="nav-link" href="reservar">Reservar</NavLink>
            <NavLink class="nav-link" href="mis-citas">Mis citas</NavLink>
            <NavLink class="nav-link" href="registro">Registro</NavLink>
            <NavLink class="nav-link" href="ingresar">Barberos</NavLink>
        }
    </nav>
</header>

<main class="container py-5">
    @Body
</main>

@code {
    protected override async Task OnInitializedAsync()
    {
        Sesion.Cambio += AlCambiarSesion;
        await Sesion.Cargar();
    }

    private void AlCambiarSesion() => InvokeAsync(StateHasChanged);

    private async Task Salir()
    {
        await Sesion.Cerrar();
        Navegacion.NavigateTo("ingresar");
    }

    public void Dispose() => Sesion.Cambio -= AlCambiarSesion;
}
