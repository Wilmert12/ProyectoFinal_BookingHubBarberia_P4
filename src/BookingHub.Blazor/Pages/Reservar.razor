@page "/reservar"
@inject ICatalogoItemApi CatalogoItemApi
@inject IBarberoApi BarberoApi
@inject ICitaApi CitaApi
@inject SesionCliente Sesion

<PageTitle>Reservar</PageTitle>

<h1 class="mb-4">Reservar una cita</h1>

<div class="row">
    <div class="col-md-8 col-lg-6">
        @if (cargando)
        {
            <p class="text-body-secondary">Cargando servicios y barberos...</p>
        }
        else if (errorCarga is not null)
        {
            <div class="alert alert-danger">@errorCarga</div>
        }
        else if (reservada is not null)
        {
            <div class="alert alert-success">
                <p class="mb-1">¡Cita reservada! <strong>@reservada.Notas</strong> con @reservada.BarberoNombre</p>
                <p class="mb-3">@reservada.FechaInicio.ToString("dd/MM/yyyy") de @reservada.FechaInicio.ToString("HH:mm") a @reservada.FechaFin.ToString("HH:mm") · @Formato.Precio(reservada.Total) · Estado: @reservada.Estado</p>
                <div class="d-flex flex-wrap align-items-center gap-3">
                    <a class="btn btn-primary" href="mis-citas">Ver mis citas</a>
                    <button type="button" class="btn btn-link p-0" @onclick="NuevaReserva">Reservar otra</button>
                </div>
            </div>
        }
        else if (revisando && ServicioSeleccionado is { } resumen && hora is not null)
        {
            <div class="card">
                <div class="card-body d-flex flex-column gap-3">
                    <h2 class="h5 mb-0">Revisa tu reserva</h2>
                    <dl class="row mb-0">
                        <dt class="col-5 fw-normal text-body-secondary">Servicio</dt>
                        <dd class="col-7">@resumen.Nombre</dd>
                        <dt class="col-5 fw-normal text-body-secondary">Barbero</dt>
                        <dd class="col-7">@barberos.FirstOrDefault(b => b.BarberoId == BarberoId)?.Nombre</dd>
                        <dt class="col-5 fw-normal text-body-secondary">Fecha</dt>
                        <dd class="col-7">@Formato.FechaLarga(fecha)</dd>
                        <dt class="col-5 fw-normal text-body-secondary">Hora</dt>
                        <dd class="col-7">@hora a @TimeOnly.Parse(hora).AddMinutes(resumen.DuracionMin ?? 30).ToString("HH:mm")</dd>
                        <dt class="col-5 fw-normal text-body-secondary">Total</dt>
                        <dd class="col-7 fw-semibold">@Formato.Precio(resumen.Precio)</dd>
                        @if (!string.IsNullOrWhiteSpace(notas))
                        {
                            <dt class="col-5 fw-normal text-body-secondary">Notas</dt>
                            <dd class="col-7">@notas</dd>
                        }
                    </dl>
                    <p class="small text-body-secondary mb-0">El pago se hace en la barbería. Puedes cancelar desde Mis citas antes de la hora.</p>

                    @if (error is not null)
                    {
                        <div class="alert alert-danger mb-0">@error</div>
                    }

                    <div class="d-flex flex-wrap align-items-center gap-3">
                        <button type="button" class="btn btn-primary" disabled="@enviando" @onclick="ConfirmarReserva">@(enviando ? "Reservando..." : "Confirmar reserva")</button>
                        <button type="button" class="btn btn-link p-0" disabled="@enviando" @onclick="() => { revisando = false; error = null; }">Cambiar algo</button>
                    </div>
                </div>
            </div>
        }
        else
        {
            <form class="vidrio d-flex flex-column gap-3 p-4" @onsubmit="Revisar">
                <div class="d-flex flex-column gap-1">
                    <label class="form-label fw-semibold mb-0" for="cliente">Número de cliente</label>
                    <input id="cliente" class="form-control" type="number" min="1" @bind="clienteId" />
                    <small class="text-body-secondary">¿No tienes uno? <a href="registro">Regístrate</a>.</small>
                </div>

                <div class="d-flex flex-column gap-1">
                    <label class="form-label fw-semibold mb-0" for="telefono">Teléfono</label>
                    <input id="telefono" class="form-control" type="tel" autocomplete="tel" maxlength="20" @bind="telefono" />
                    <small class="text-body-secondary">El mismo con el que te registraste.</small>
                </div>

                <div class="d-flex flex-column gap-1">
                    <label class="form-label fw-semibold mb-0" for="servicio">Servicio</label>
                    <select id="servicio" class="form-select" @bind="ServicioId" @bind:after="CargarHoras">
                        <option value="">Elige un servicio</option>
                        @foreach (var servicio in servicios)
                        {
                            <option value="@servicio.CatalogoItemId">@servicio.Nombre · @Formato.Precio(servicio.Precio) · @servicio.DuracionMin min</option>
                        }
                    </select>
                </div>

                <div class="d-flex flex-column gap-1">
                    <label class="form-label fw-semibold mb-0" for="barbero">Barbero</label>
                    <select id="barbero" class="form-select" @bind="BarberoId" @bind:after="CargarHoras">
                        <option value="">Elige un barbero</option>
                        @foreach (var barbero in barberos)
                        {
                            <option value="@barbero.BarberoId">@barbero.Nombre</option>
                        }
                    </select>
                </div>

                <div class="d-flex flex-column flex-sm-row gap-3">
                    <div class="d-flex flex-column gap-1 flex-grow-1">
                        <label class="form-label fw-semibold mb-0" for="fecha">Fecha</label>
                        <input id="fecha" class="form-control" type="date" min="@Hoy.ToString("yyyy-MM-dd")" @bind="fecha" @bind:after="CargarHoras" />
                    </div>
                    <div class="d-flex flex-column gap-1 flex-grow-1">
                        <label class="form-label fw-semibold mb-0" for="hora">Hora</label>
                        <select id="hora" class="form-select" @bind="hora" disabled="@(horas.Count == 0)">
                            <option value="">@(horas.Count == 0 ? "—" : "Elige una hora")</option>
                            @foreach (var opcion in horas)
                            {
                                <option value="@opcion">@opcion</option>
                            }
                        </select>
                        @if (mensajeHoras is not null)
                        {
                            <small class="text-body-secondary">@mensajeHoras</small>
                        }
                    </div>
                </div>

                <div class="d-flex flex-column gap-1">
                    <label class="form-label fw-semibold mb-0" for="notas">Notas (opcional)</label>
                    <input id="notas" class="form-control" @bind="notas" maxlength="200" />
                </div>

                @if (ServicioSeleccionado is { } seleccionado && hora is not null)
                {
                    <div class="alert alert-info d-flex justify-content-between align-items-center py-2 mb-0">
                        <span>Total: <strong>@Formato.Precio(seleccionado.Precio)</strong></span>
                        <span>Termina a las @TimeOnly.Parse(hora).AddMinutes(seleccionado.DuracionMin ?? 0).ToString("HH:mm")</span>
                    </div>
                }

                @if (error is not null)
                {
                    <div class="alert alert-danger mb-0">@error</div>
                }

                <button class="btn btn-primary align-self-start" type="submit">Continuar</button>
            </form>
        }
    </div>
</div>

@code {
    private const int EstadoPendienteId = 1;

    [SupplyParameterFromQuery]
    public int? ServicioId { get; set; }

    [SupplyParameterFromQuery]
    public int? BarberoId { get; set; }

    private List<CatalogoItemDto> servicios = [];
    private List<BarberoDto> barberos = [];
    private int? clienteId;
    private string? telefono;
    private DateOnly fecha = Formato.Hoy.AddDays(1);
    private string? hora;
    private List<string> horas = [];
    private string? mensajeHoras = "Elige servicio, barbero y fecha para ver las horas libres.";
    private string? notas;
    private CitaDto? reservada;
    private bool cargando = true;
    private bool enviando;
    private string? errorCarga;
    private string? error;

    private static DateOnly Hoy => Formato.Hoy;

    private CatalogoItemDto? ServicioSeleccionado =>
        servicios.FirstOrDefault(s => s.CatalogoItemId == ServicioId);

    protected override async Task OnInitializedAsync()
    {
        clienteId = Sesion.ClienteId;
        telefono = Sesion.Telefono;

        try
        {
            var itemsTarea = CatalogoItemApi.GetCatalogoItems();
            var barberosTarea = BarberoApi.GetBarberos();
            await Task.WhenAll(itemsTarea, barberosTarea);

            servicios = itemsTarea.Result.Where(i => i.EsServicio).ToList();
            barberos = barberosTarea.Result;
        }
        catch (Exception ex) when (Formato.EsErrorDeApi(ex))
        {
            errorCarga = "No se pudieron cargar los servicios. Verifica que la API esté en ejecución.";
        }
        finally
        {
            cargando = false;
        }

        await CargarHoras();
    }

    private async Task CargarHoras()
    {
        if (ServicioSeleccionado is not { } servicio || BarberoId is not { } barberoId)
        {
            horas = [];
            hora = null;
            mensajeHoras = "Elige servicio, barbero y fecha para ver las horas libres.";
            return;
        }

        mensajeHoras = "Buscando horas libres...";
        try
        {
            var disponibilidad = await BarberoApi.GetDisponibilidad(barberoId, fecha, servicio.DuracionMin ?? 30);
            horas = disponibilidad.Horarios.Select(h => h.Inicio.ToString("HH:mm")).ToList();
            mensajeHoras = horas.Count == 0 ? "Este barbero no tiene horas libres ese día. Prueba otra fecha." : null;
        }
        catch (Exception ex) when (Formato.EsErrorDeApi(ex))
        {
            horas = [];
            mensajeHoras = "No se pudieron cargar las horas libres.";
        }

        if (hora is not null && !horas.Contains(hora))
            hora = null;
    }

    private bool revisando;

    private void Revisar()
    {
        error = Validar();
        revisando = error is null;
    }

    private async Task ConfirmarReserva()
    {
        error = Validar();
        if (error is not null)
        {
            revisando = false;
            return;
        }

        var servicio = ServicioSeleccionado!;
        var inicio = fecha.ToDateTime(TimeOnly.Parse(hora!));

        var cita = new CitaDto
        {
            ClienteId = clienteId!.Value,
            BarberoId = BarberoId!.Value,
            EstadoCitaId = EstadoPendienteId,
            FechaInicio = inicio,
            FechaFin = inicio.AddMinutes(servicio.DuracionMin ?? 30),
            Total = servicio.Precio,
            Notas = string.IsNullOrWhiteSpace(notas) ? servicio.Nombre : $"{servicio.Nombre} - {notas.Trim()}",
            Detalles = [new CitaDetalleDto { CatalogoItemId = servicio.CatalogoItemId, Cantidad = 1, PrecioUnitario = servicio.Precio }]
        };

        enviando = true;

        try
        {
            reservada = await CitaApi.CrearCita(cita, telefono!.Trim());
            Sesion.ClienteId = clienteId;
            Sesion.Telefono = telefono.Trim();
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            error = "El número de cliente y el teléfono no coinciden.";
        }
        catch (Refit.ApiException ex) when (ex.Content?.Contains("CITA_CHOQUE") == true)
        {
            error = "Esa hora se acaba de ocupar. Elige otra.";
            await CargarHoras();
        }
        catch (Exception ex) when (Formato.EsErrorDeApi(ex))
        {
            error = "No se pudo reservar la cita. Verifica tu número de cliente e intenta de nuevo.";
        }
        finally
        {
            enviando = false;
        }
    }

    private string? Validar()
    {
        if (clienteId is null or < 1)
            return "Escribe tu número de cliente.";
        if (string.IsNullOrWhiteSpace(telefono))
            return "Escribe tu teléfono.";
        if (ServicioSeleccionado is null)
            return "Elige un servicio.";
        if (BarberoId is null)
            return "Elige un barbero.";
        if (hora is null)
            return "Elige una hora.";
        if (fecha.ToDateTime(TimeOnly.Parse(hora)) <= Formato.Ahora)
            return "Elige una fecha y hora futuras.";
        return null;
    }

    private async Task NuevaReserva()
    {
        reservada = null;
        revisando = false;
        hora = null;
        notas = null;
        await CargarHoras();
    }
}
