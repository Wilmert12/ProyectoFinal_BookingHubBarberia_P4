@page "/mis-citas"
@inject ICitaApi CitaApi
@inject SesionCliente Sesion

<PageTitle>Mis Citas</PageTitle>

<h1 class="mb-2">Mis Citas</h1>
<p class="text-body-secondary mb-4">Escribe tu número de cliente y el teléfono con el que te registraste.</p>

<form class="d-flex flex-wrap align-items-end gap-3 mb-4" @onsubmit="Buscar">
    <div class="d-flex flex-column gap-1">
        <label class="form-label fw-semibold mb-0" for="clienteId">Número de cliente</label>
        <input id="clienteId" class="form-control" type="number" min="1" @bind="clienteId" />
    </div>
    <div class="d-flex flex-column gap-1">
        <label class="form-label fw-semibold mb-0" for="telefono">Teléfono</label>
        <input id="telefono" class="form-control" type="tel" autocomplete="tel" maxlength="20" @bind="telefono" />
    </div>
    <button class="btn btn-primary" type="submit" disabled="@cargando">Buscar</button>
</form>

@if (cargando)
{
    <p class="text-body-secondary">Cargando citas...</p>
}
else if (error is not null)
{
    <div class="alert alert-danger">@error</div>
}
else if (citas is not null)
{
    @if (citas.Count == 0)
    {
        <p class="text-body-secondary">Todavía no tienes citas.</p>
    }
    else
    {
        <h2 class="h4 mb-3">Próximas</h2>
        <TablaCitas Citas="@citas.Where(c => c.FechaInicio >= DateTime.Now).ToList()" Vacio="No tienes citas próximas." />

        <h2 class="h4 mb-3">Historial</h2>
        <TablaCitas Citas="@citas.Where(c => c.FechaInicio < DateTime.Now).OrderByDescending(c => c.FechaInicio).ToList()" Vacio="Aún no tienes visitas pasadas." />
    }
}

@code {
    private int? clienteId;
    private string? telefono;
    private List<CitaDto>? citas;
    private bool cargando;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        clienteId = Sesion.ClienteId;
        telefono = Sesion.Telefono;

        if (clienteId is not null && !string.IsNullOrWhiteSpace(telefono))
            await Buscar();
    }

    private async Task Buscar()
    {
        error = null;
        citas = null;
        if (clienteId is null or < 1 || string.IsNullOrWhiteSpace(telefono))
        {
            error = "Escribe tu número de cliente y tu teléfono.";
            return;
        }

        cargando = true;
        try
        {
            citas = await CitaApi.GetCitasCliente(clienteId.Value, telefono.Trim());
            Sesion.ClienteId = clienteId;
            Sesion.Telefono = telefono.Trim();
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            error = "El número de cliente y el teléfono no coinciden.";
        }
        catch (Exception ex) when (Formato.EsErrorDeApi(ex))
        {
            error = "No se pudo conectar con la API. Intenta de nuevo.";
        }
        finally
        {
            cargando = false;
        }
    }
}
