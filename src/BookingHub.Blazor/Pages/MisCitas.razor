@page "/mis-citas"
@inject ICitaApi CitaApi
@inject SesionCliente Sesion

<PageTitle>Mis Citas</PageTitle>

<h1 class="mb-2">Mis Citas</h1>
<p class="text-body-secondary mb-4">Escribe tu número de cliente y el teléfono con el que te registraste.</p>

<form class="vidrio d-flex flex-column flex-md-row align-items-md-end gap-3 p-3 mb-4" @onsubmit="Buscar">
    <div class="d-flex flex-column gap-1">
        <label class="form-label fw-semibold mb-0" for="clienteId">Número de cliente</label>
        <input id="clienteId" class="form-control" type="number" min="1" @bind="clienteId" />
    </div>
    <div class="d-flex flex-column gap-1">
        <label class="form-label fw-semibold mb-0" for="telefono">Teléfono</label>
        <input id="telefono" class="form-control" type="tel" autocomplete="tel" maxlength="20" @bind="telefono" />
    </div>
    <button class="btn btn-primary" type="submit" disabled="@cargando">Buscar</button>
</form>
<div class="d-flex flex-wrap gap-3 small mb-4">
    <a href="recuperar">¿Olvidaste tu número?</a>
    @if (Sesion.Recordado)
    {
        <button type="button" class="btn btn-link btn-sm p-0" @onclick="NoSoyYo">No soy yo (olvidar mis datos en este navegador)</button>
    }
</div>

@if (cargando)
{
    <p class="text-body-secondary">Cargando citas...</p>
}
else if (error is not null)
{
    <div class="alert alert-danger">@error</div>
}
else if (citas is not null)
{
    @if (citas.Count == 0)
    {
        <p class="text-body-secondary">Todavía no tienes citas.</p>
    }
    else
    {
        @if (aviso is not null)
        {
            <div class="alert @(avisoEsError ? "alert-danger" : "alert-success") py-2">@aviso</div>
        }

        <h2 class="h4 mb-3">Próximas</h2>
        <TablaCitas Citas="@citas.Where(c => c.FechaInicio >= Formato.Ahora).ToList()" Vacio="No tienes citas próximas.">
            <Acciones Context="cita">
                @if (EsCancelable(cita))
                {
                    @if (confirmandoId == cita.CitaId)
                    {
                        <div class="d-inline-flex align-items-center gap-2">
                            <span class="small">¿Cancelar?</span>
                            <button type="button" class="btn btn-sm btn-danger" disabled="@cancelando" @onclick="() => Cancelar(cita)">Sí</button>
                            <button type="button" class="btn btn-sm btn-link" disabled="@cancelando" @onclick="() => confirmandoId = null">No</button>
                        </div>
                    }
                    else
                    {
                        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => confirmandoId = cita.CitaId">Cancelar</button>
                    }
                }
            </Acciones>
        </TablaCitas>

        <h2 class="h4 mb-3">Historial</h2>
        <TablaCitas Citas="@citas.Where(c => c.FechaInicio < Formato.Ahora).OrderByDescending(c => c.FechaInicio).ToList()" Vacio="Aún no tienes visitas pasadas." />
    }
}

@code {
    private int? clienteId;
    private string? telefono;
    private List<CitaDto>? citas;
    private bool cargando;
    private string? error;
    private int? confirmandoId;
    private bool cancelando;
    private string? aviso;
    private bool avisoEsError;

    private async Task NoSoyYo()
    {
        await Sesion.Olvidar();
        clienteId = null;
        telefono = null;
        citas = null;
        error = null;
        aviso = null;
    }

    private static bool EsCancelable(CitaDto cita) =>
        cita.Estado is "Pendiente" or "Confirmada" && cita.FechaInicio > Formato.Ahora;

    private async Task Cancelar(CitaDto cita)
    {
        cancelando = true;
        aviso = null;
        try
        {
            await CitaApi.CancelarCita(cita.CitaId, Sesion.Telefono ?? telefono ?? "");
            aviso = $"Cancelaste la cita del {cita.FechaInicio:dd/MM/yyyy} a las {cita.FechaInicio:HH:mm}.";
            avisoEsError = false;
            citas = await CitaApi.GetCitasCliente(clienteId!.Value, (Sesion.Telefono ?? telefono)!.Trim());
        }
        catch (Refit.ApiException ex)
        {
            aviso = Formato.DescripcionError(ex) ?? "No se pudo cancelar la cita. Intenta de nuevo.";
            avisoEsError = true;
        }
        catch (Exception ex) when (Formato.EsErrorDeApi(ex))
        {
            aviso = "No se pudo conectar con la API. Intenta de nuevo.";
            avisoEsError = true;
        }
        finally
        {
            cancelando = false;
            confirmandoId = null;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await Sesion.Cargar();
        clienteId = Sesion.ClienteId;
        telefono = Sesion.Telefono;

        if (Sesion.Recordado)
            await Buscar();
    }

    private async Task Buscar()
    {
        error = null;
        aviso = null;
        citas = null;
        if (clienteId is null or < 1 || string.IsNullOrWhiteSpace(telefono))
        {
            error = "Escribe tu número de cliente y tu teléfono.";
            return;
        }

        cargando = true;
        try
        {
            citas = await CitaApi.GetCitasCliente(clienteId.Value, telefono.Trim());
            await Sesion.Recordar(clienteId.Value, telefono);
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            error = "El número de cliente y el teléfono no coinciden.";
        }
        catch (Exception ex) when (Formato.EsErrorDeApi(ex))
        {
            error = Formato.Mensaje(ex, "No se pudo conectar con la API. Intenta de nuevo.");
        }
        finally
        {
            cargando = false;
        }
    }
}
