@page "/"
@page "/catalogo"
@inject ICatalogoItemApi CatalogoItemApi
@inject IBarberoApi BarberoApi

<PageTitle>Catálogo</PageTitle>

<h1 class="mb-4">Catálogo</h1>

@if (cargando)
{
    <p class="text-body-secondary">Cargando catálogo...</p>
}
else if (error is not null)
{
    <div class="alert alert-danger">@error</div>
}
else
{
    <h2 class="h4 mb-3">Servicios</h2>
    @if (servicios.Count == 0)
    {
        <p class="text-body-secondary">Aún no hay servicios disponibles.</p>
    }
    else
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-3 mb-5">
            @foreach (var servicio in servicios)
            {
                <div class="col">
                    <article class="card h-100 shadow-sm">
                        <div class="card-body d-flex flex-column gap-2">
                            <h3 class="h6 card-title mb-0">@servicio.Nombre</h3>
                            @if (!string.IsNullOrWhiteSpace(servicio.Descripcion))
                            {
                                <p class="card-text text-body-secondary mb-0">@servicio.Descripcion</p>
                            }
                            @* Como la tarjeta de perfil: datos en columna con flex-grow-1 y el botón empujado a la derecha. *@
                            <div class="d-flex align-items-center gap-3 mt-auto">
                                <div class="d-flex flex-column flex-grow-1">
                                    <span class="fw-semibold">@Formato.Precio(servicio.Precio)</span>
                                    <small class="text-body-secondary">@servicio.DuracionMin min</small>
                                </div>
                                <a class="btn btn-primary btn-sm" href="reservar?servicioId=@servicio.CatalogoItemId">Reservar</a>
                            </div>
                        </div>
                    </article>
                </div>
            }
        </div>
    }

    <h2 class="h4 mb-3">Productos</h2>
    @if (productos.Count == 0)
    {
        <p class="text-body-secondary">Aún no hay productos disponibles.</p>
    }
    else
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-3 mb-5">
            @foreach (var producto in productos)
            {
                <div class="col">
                    <article class="card h-100 shadow-sm">
                        <div class="card-body d-flex flex-column gap-2">
                            <h3 class="h6 card-title mb-0">@producto.Nombre</h3>
                            @if (!string.IsNullOrWhiteSpace(producto.Descripcion))
                            {
                                <p class="card-text text-body-secondary mb-0">@producto.Descripcion</p>
                            }
                            <div class="d-flex justify-content-between align-items-center mt-auto">
                                <span class="fw-semibold">@Formato.Precio(producto.Precio)</span>
                                <span class="text-body-secondary small">Disponible en el local</span>
                            </div>
                        </div>
                    </article>
                </div>
            }
        </div>
    }

    <h2 class="h4 mb-3">Nuestro equipo</h2>
    @if (barberos.Count == 0)
    {
        <p class="text-body-secondary">Aún no hay barberos registrados.</p>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 g-3">
            @foreach (var barbero in barberos)
            {
                <div class="col">
                    <article class="card h-100 shadow-sm">
                        <div class="card-body d-flex align-items-center gap-3">
                            <span class="d-flex justify-content-center align-items-center flex-shrink-0 rounded-circle text-white fw-bold fs-5"
                                  style="width: 3rem; height: 3rem; background: @barbero.ColorHex">@Inicial(barbero.Nombre)</span>
                            <div class="d-flex flex-column flex-grow-1">
                                <h3 class="h6 mb-0">@barbero.Nombre</h3>
                                @if (!string.IsNullOrWhiteSpace(barbero.Apodo))
                                {
                                    <small class="text-body-secondary">"@barbero.Apodo"</small>
                                }
                            </div>
                            <a class="btn btn-outline-primary btn-sm" href="reservar?barberoId=@barbero.BarberoId">Reservar</a>
                        </div>
                    </article>
                </div>
            }
        </div>
    }
}

@code {
    private List<CatalogoItemDto> servicios = [];
    private List<CatalogoItemDto> productos = [];
    private List<BarberoDto> barberos = [];
    private bool cargando = true;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var itemsTarea = CatalogoItemApi.GetCatalogoItems();
            var barberosTarea = BarberoApi.GetBarberos();
            await Task.WhenAll(itemsTarea, barberosTarea);

            servicios = itemsTarea.Result.Where(i => i.EsServicio).ToList();
            productos = itemsTarea.Result.Where(i => !i.EsServicio).ToList();
            barberos = barberosTarea.Result;
        }
        catch (Exception ex) when (Formato.EsErrorDeApi(ex))
        {
            error = "No se pudo cargar el catálogo. Verifica que la API esté en ejecución.";
        }
        finally
        {
            cargando = false;
        }
    }

    private static string Inicial(string? nombre) =>
        string.IsNullOrWhiteSpace(nombre) ? "?" : nombre[..1].ToUpperInvariant();

    private static string PrimerNombre(string? nombre) =>
        nombre?.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "este barbero";
}
