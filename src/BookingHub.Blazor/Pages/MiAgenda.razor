@page "/mi-agenda"
@inject ICitaApi CitaApi
@inject IBarberoApi BarberoApi
@inject SesionUsuario Sesion
@inject NavigationManager Navegacion

<PageTitle>Mi agenda</PageTitle>

@if (Sesion.Actual is { } usuario)
{
    <div class="d-flex flex-column flex-md-row justify-content-md-between align-items-md-end gap-3 mb-4">
        <div>
            <p class="text-body-secondary mb-1">Hola, @usuario.Nombre</p>
            <h1 class="mb-0">Mi agenda</h1>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-2">
            <div class="btn-group" role="group" aria-label="Vista">
                <button type="button" class="btn btn-sm @(semana ? "btn-outline-secondary" : "btn-primary")" @onclick="() => CambiarVista(false)">Día</button>
                <button type="button" class="btn btn-sm @(semana ? "btn-primary" : "btn-outline-secondary")" @onclick="() => CambiarVista(true)">Semana</button>
            </div>
            <button type="button" class="btn btn-outline-secondary" @onclick="() => CambiarDia(-1)" aria-label="Anterior">‹</button>
            <input class="form-control w-auto" type="date" @bind="fecha" @bind:after="Cargar" aria-label="Fecha" />
            <button type="button" class="btn btn-outline-secondary" @onclick="() => CambiarDia(1)" aria-label="Siguiente">›</button>
            @if (fecha != Hoy)
            {
                <button type="button" class="btn btn-link" @onclick="IrAHoy">Hoy</button>
            }
        </div>
    </div>

    <p class="fw-semibold mb-3">@(semana ? $"Semana del {Formato.FechaLarga(Lunes)} al {Formato.FechaLarga(Lunes.AddDays(6))}" : Formato.FechaLarga(fecha))</p>

    @if (cargando)
    {
        <p class="text-body-secondary">Cargando agenda...</p>
    }
    else if (error is not null)
    {
        <div class="alert alert-danger">@error</div>
    }
    else if (semana)
    {
        var activasSemana = citasSemana.Where(c => !EsLibre(c)).ToList();
        <div class="row g-3 mb-4">
            <div class="col-4">
                <div class="card h-100"><div class="card-body">
                    <div class="text-body-secondary small">Citas de la semana</div>
                    <div class="fs-4 fw-semibold">@activasSemana.Count</div>
                </div></div>
            </div>
            <div class="col-4">
                <div class="card h-100"><div class="card-body">
                    <div class="text-body-secondary small">Completadas</div>
                    <div class="fs-4 fw-semibold">@citasSemana.Count(c => c.Estado == "Completada")</div>
                </div></div>
            </div>
            <div class="col-4">
                <div class="card h-100"><div class="card-body">
                    <div class="text-body-secondary small">Total de la semana</div>
                    <div class="fs-4 fw-semibold">@Formato.Precio(activasSemana.Sum(c => c.Total))</div>
                </div></div>
            </div>
        </div>

        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3">
            @for (var i = 0; i < 7; i++)
            {
                var dia = Lunes.AddDays(i);
                var delDia = citasSemana.Where(c => DateOnly.FromDateTime(c.FechaInicio) == dia).OrderBy(c => c.FechaInicio).ToList();
                <div class="col">
                    <div class="card h-100 @(dia == Hoy ? "border-2" : "")" style="@(dia == Hoy ? "border-color: var(--acento)" : "")">
                        <div class="card-body d-flex flex-column gap-2">
                            <div class="d-flex justify-content-between align-items-center">
                                <button type="button" class="btn btn-link p-0 fw-semibold text-decoration-none" @onclick="() => VerDia(dia)">@Formato.FechaLarga(dia)</button>
                                <span class="small text-body-secondary">@(delDia.Count(c => !EsLibre(c))) citas</span>
                            </div>
                            @if (delDia.Count == 0)
                            {
                                <span class="small text-body-secondary">Libre</span>
                            }
                            @foreach (var cita in delDia)
                            {
                                <div class="d-flex align-items-center gap-2 small @(EsLibre(cita) ? "opacity-50" : "")">
                                    <span class="fw-semibold agenda-hora">@cita.FechaInicio.ToString("HH:mm")</span>
                                    <span class="flex-grow-1 text-truncate">@cita.ClienteNombre · @Servicios(cita)</span>
                                    <span class="badge rounded-pill @TablaCitas.ClaseEstado(cita.Estado)">@Formato.Estado(cita.Estado)</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="row g-3 mb-4">
            <div class="col-6 col-md-3">
                <div class="card h-100"><div class="card-body">
                    <div class="text-body-secondary small">Citas</div>
                    <div class="fs-4 fw-semibold">@CitasActivas().Count</div>
                </div></div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card h-100"><div class="card-body">
                    <div class="text-body-secondary small">Completadas</div>
                    <div class="fs-4 fw-semibold">@citas.Count(c => c.Estado == "Completada")</div>
                </div></div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card h-100"><div class="card-body">
                    <div class="text-body-secondary small">Próxima</div>
                    <div class="fs-4 fw-semibold">@(Proxima?.FechaInicio.ToString("HH:mm") ?? "—")</div>
                </div></div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card h-100"><div class="card-body">
                    <div class="text-body-secondary small">Total del día</div>
                    <div class="fs-4 fw-semibold">@Formato.Precio(CitasActivas().Sum(c => c.Total))</div>
                </div></div>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-lg-8">
                <h2 class="h5 mb-3">Citas</h2>
                @if (avisoEstado is not null)
                {
                    <div class="alert alert-danger py-2">@avisoEstado</div>
                }
                @if (citas.Count == 0)
                {
                    <p class="text-body-secondary">No tienes citas este día.</p>
                }
                else
                {
                    <ul class="list-group">
                        @foreach (var cita in citas)
                        {
                            <li class="list-group-item d-flex gap-3 py-3 @(EsLibre(cita) ? "opacity-50" : "")">
                                <div class="agenda-hora">
                                    <div class="fw-semibold">@cita.FechaInicio.ToString("HH:mm")</div>
                                    <div class="small text-body-secondary">@cita.FechaFin.ToString("HH:mm")</div>
                                </div>
                                <div class="flex-grow-1">
                                    <div class="d-flex flex-wrap justify-content-between gap-2">
                                        <span class="fw-semibold">@cita.ClienteNombre</span>
                                        <span class="badge rounded-pill align-self-start @TablaCitas.ClaseEstado(cita.Estado)">@Formato.Estado(cita.Estado)</span>
                                    </div>
                                    <div class="text-body-secondary">@Servicios(cita)</div>
                                    <div class="small">@Formato.Precio(cita.Total)</div>
                                    @if (Siguientes(cita) is { Count: > 0 } opciones)
                                    {
                                        <div class="d-flex flex-wrap gap-2 mt-2">
                                            @foreach (var (estado, texto, clase) in opciones)
                                            {
                                                <button type="button" class="btn btn-sm @clase" disabled="@(cambiandoId == cita.CitaId)"
                                                        @onclick="() => CambiarEstado(cita, estado)">@texto</button>
                                            }
                                        </div>
                                    }
                                </div>
                            </li>
                        }
                    </ul>
                }
            </div>
            <div class="col-lg-4">
                <h2 class="h5 mb-3">Horas libres</h2>
                @if (libres is null)
                {
                    <p class="text-body-secondary">No se pudieron calcular.</p>
                }
                else if (libres.Count == 0)
                {
                    <p class="text-body-secondary">Sin horas libres este día.</p>
                }
                else
                {
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var libre in libres)
                        {
                            <span class="badge rounded-pill text-bg-light border fw-normal px-3 py-2">@libre.Inicio.ToString("HH:mm")</span>
                        }
                    </div>
                }
            </div>
        </div>
    }
}

@code {
    private DateOnly fecha = Formato.Hoy;
    private List<CitaDto> citas = [];
    private List<CitaDto> citasSemana = [];
    private bool semana;

    // Semana de lunes a domingo que contiene la fecha elegida.
    private DateOnly Lunes => fecha.AddDays(-(((int)fecha.DayOfWeek + 6) % 7));
    private List<HorarioLibreDto>? libres;
    private int? barberoId;
    private bool cargando = true;
    private string? error;

    private static DateOnly Hoy => Formato.Hoy;

    private List<CitaDto> CitasActivas() => citas.Where(c => !EsLibre(c)).ToList();

    private CitaDto? Proxima => fecha == Hoy
        ? CitasActivas().FirstOrDefault(c => c.FechaInicio >= Formato.Ahora)
        : CitasActivas().FirstOrDefault();

    protected override async Task OnInitializedAsync()
    {
        await Sesion.Cargar();
        if (!Sesion.EsBarbero)
        {
            Navegacion.NavigateTo("ingresar");
            return;
        }

        await Cargar();
    }

    private async Task CambiarDia(int dias)
    {
        fecha = fecha.AddDays(semana ? dias * 7 : dias);
        await Cargar();
    }

    private async Task CambiarVista(bool verSemana)
    {
        if (semana == verSemana)
            return;
        semana = verSemana;
        await Cargar();
    }

    private async Task VerDia(DateOnly dia)
    {
        fecha = dia;
        semana = false;
        await Cargar();
    }

    private async Task IrAHoy()
    {
        fecha = Hoy;
        await Cargar();
    }

    private async Task Cargar()
    {
        cargando = true;
        error = null;

        try
        {
            if (semana)
            {
                citasSemana = await CitaApi.GetMisCitas(Lunes, 7);
                return;
            }

            barberoId ??= (await BarberoApi.GetBarberos())
                .FirstOrDefault(b => b.UsuarioId == Sesion.Actual!.UsuarioId)?.BarberoId;

            var citasTarea = CitaApi.GetMisCitas(fecha);
            var disponibilidad = barberoId is { } id
                ? await BarberoApi.GetDisponibilidad(id, fecha, 30)
                : null;

            citas = await citasTarea;
            libres = disponibilidad?.Horarios;
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            await Sesion.Cerrar();
            Navegacion.NavigateTo("ingresar");
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            error = "Tu usuario no tiene un perfil de barbero. Pide al administrador que lo cree.";
        }
        catch (Exception ex) when (Formato.EsErrorDeApi(ex))
        {
            error = "No se pudo cargar la agenda. Verifica tu conexión e intenta de nuevo.";
        }
        finally
        {
            cargando = false;
        }
    }

    private List<EstadoCitaDto> estados = [];
    private int? cambiandoId;
    private string? avisoEstado;

    /// <summary>Botones que tiene sentido mostrar según el estado actual de la cita.</summary>
    private static List<(string Estado, string Texto, string Clase)> Siguientes(CitaDto cita) => cita.Estado switch
    {
        "Pendiente" => [("Confirmada", "Confirmar", "btn-outline-secondary"), ("EnProceso", "Empezar", "btn-outline-primary"), ("NoShow", "No vino", "btn-outline-danger")],
        "Confirmada" => [("EnProceso", "Empezar", "btn-outline-primary"), ("Completada", "Completada", "btn-outline-success"), ("NoShow", "No vino", "btn-outline-danger")],
        "EnProceso" => [("Completada", "Completada", "btn-outline-success")],
        _ => []
    };

    private async Task CambiarEstado(CitaDto cita, string estado)
    {
        cambiandoId = cita.CitaId;
        avisoEstado = null;
        try
        {
            if (estados.Count == 0)
                estados = await CitaApi.GetEstados();

            var estadoId = estados.FirstOrDefault(e => e.Descripcion == estado)?.EstadoCitaId;
            if (estadoId is null)
            {
                avisoEstado = $"No existe el estado {estado}.";
                return;
            }

            await CitaApi.CambiarEstado(cita.CitaId, new CambioEstadoDto(estadoId.Value));
            await Cargar();
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            await Sesion.Cerrar();
            Navegacion.NavigateTo("ingresar");
        }
        catch (Refit.ApiException ex)
        {
            avisoEstado = Formato.DescripcionError(ex) ?? "No se pudo cambiar el estado de la cita.";
        }
        catch (Exception ex) when (Formato.EsErrorDeApi(ex))
        {
            avisoEstado = "No se pudo conectar con la API. Intenta de nuevo.";
        }
        finally
        {
            cambiandoId = null;
        }
    }

    private static bool EsLibre(CitaDto cita) => cita.Estado is "Cancelada" or "NoShow";

    private static string Servicios(CitaDto cita) =>
        cita.Detalles is { Count: > 0 } detalles
            ? string.Join(", ", detalles.Select(d => d.Nombre))
            : cita.Notas ?? string.Empty;
}
