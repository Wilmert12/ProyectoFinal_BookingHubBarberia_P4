@page "/registro"
@inject IClienteApi ClienteApi
@inject SesionCliente Sesion

<PageTitle>Registro</PageTitle>

<h1 class="mb-4">Registro</h1>

<div class="row">
    <div class="col-md-8 col-lg-6">
        @if (registrado is not null)
        {
            <div class="alert alert-success">
                <p class="mb-1">¡Listo, @registrado.Nombre! Tu número de cliente es <strong>@registrado.ClienteId</strong>.</p>
                <p class="mb-3">Guárdalo: con ese número y tu teléfono reservas y ves tus citas.</p>
                <div class="d-flex flex-wrap align-items-center gap-3">
                    <a class="btn btn-primary" href="reservar">Reservar una cita</a>
                    <a class="link-primary" href="mis-citas">Ver mis citas</a>
                </div>
            </div>
        }
        else
        {
            <form class="d-flex flex-column gap-3" @onsubmit="Registrar">
                <div class="d-flex flex-column gap-1">
                    <label class="form-label fw-semibold mb-0" for="nombre">Nombre completo</label>
                    <input id="nombre" class="form-control" @bind="cliente.Nombre" maxlength="200" />
                </div>

                <div class="d-flex flex-column gap-1">
                    <label class="form-label fw-semibold mb-0" for="telefono">Teléfono</label>
                    <input id="telefono" class="form-control" type="tel" @bind="cliente.Telefono" maxlength="20" />
                </div>

                <div class="d-flex flex-column gap-1">
                    <label class="form-label fw-semibold mb-0" for="email">Correo (opcional)</label>
                    <input id="email" class="form-control" type="email" @bind="cliente.Email" maxlength="255" />
                </div>

                @if (error is not null)
                {
                    <div class="alert alert-danger mb-0">@error</div>
                }

                <button class="btn btn-primary align-self-start" type="submit" disabled="@enviando">@(enviando ? "Registrando..." : "Registrarme")</button>
            </form>
        }
    </div>
</div>

@code {
    private ClienteDto cliente = new();
    private ClienteDto? registrado;
    private bool enviando;
    private string? error;

    private async Task Registrar()
    {
        if (string.IsNullOrWhiteSpace(cliente.Nombre) || string.IsNullOrWhiteSpace(cliente.Telefono))
        {
            error = "El nombre y el teléfono son obligatorios.";
            return;
        }

        enviando = true;
        error = null;

        try
        {
            cliente.Email = string.IsNullOrWhiteSpace(cliente.Email) ? null : cliente.Email.Trim();
            registrado = await ClienteApi.CrearCliente(cliente);
            Sesion.ClienteId = registrado.ClienteId;
            Sesion.Telefono = registrado.Telefono;
        }
        catch (Exception ex) when (Formato.EsErrorDeApi(ex))
        {
            error = "No se pudo completar el registro. Intenta de nuevo.";
        }
        finally
        {
            enviando = false;
        }
    }
}
