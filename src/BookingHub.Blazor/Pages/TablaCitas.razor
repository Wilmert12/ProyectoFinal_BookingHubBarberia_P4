
@if (Citas.Count == 0)
{
    <p class="text-body-secondary mb-4">@Vacio</p>
}
else
{
    <div class="table-responsive vidrio mb-4">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Horario</th>
                    <th>Barbero</th>
                    <th>Estado</th>
                    <th class="text-end">Total</th>
                    <th class="d-none d-md-table-cell">Notas</th>
                    @if (Acciones is not null)
                    {
                        <th><span class="visually-hidden">Acciones</span></th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var cita in Citas)
                {
                    <tr>
                        <td>@cita.FechaInicio.ToString("dd/MM/yyyy")</td>
                        <td>@cita.FechaInicio.ToString("HH:mm") - @cita.FechaFin.ToString("HH:mm")</td>
                        <td>@cita.BarberoNombre</td>
                        <td><span class="badge rounded-pill @ClaseEstado(cita.Estado)">@Formato.Estado(cita.Estado)</span></td>
                        <td class="text-end">@Formato.Precio(cita.Total)</td>
                        <td class="d-none d-md-table-cell">@cita.Notas</td>
                        @if (Acciones is not null)
                        {
                            <td class="text-end text-nowrap">@Acciones(cita)</td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public List<CitaDto> Citas { get; set; } = [];

    [Parameter]
    public string Vacio { get; set; } = "Sin citas.";

    /// <summary>Botones opcionales al final de cada fila.</summary>
    [Parameter]
    public RenderFragment<CitaDto>? Acciones { get; set; }

    public static string ClaseEstado(string? estado) => estado switch
    {
        "Pendiente" => "text-bg-warning",
        "Confirmada" => "text-bg-info",
        "EnProceso" => "text-bg-primary",
        "Completada" => "text-bg-success",
        "Cancelada" or "NoShow" => "text-bg-danger",
        _ => "text-bg-secondary"
    };
}
